{
  "name": "iideas18-hexo-reconstructed",
  "private": true,
  "version": "1.0.0",
  "hexo": {
    "version": "8.1.1"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('public', { recursive: true, force: true }); fs.rmSync('db.json', { force: true });\"",
    "import": "python3 ../scripts/import_notes.py",
    "generate": "npm run import && node tools/generate.js",
    "publish-root": "npm run import && node tools/generate.js --sync-root"
  },
  "dependencies": {
    "hexo": "^8.1.1",
    "hexo-cli": "^4.3.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-server": "^3.0.0"
  }
}
